.DS_Store
.AppleDouble
.LSOverride

# Editors
.idea/
.vscode/
*.swp
*.swo
*~

# Local coding-agent instructions
/AGENTS.md

# Python bytecode and tool caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Local environments and secrets
.venv/
venv/
env/
ENV/
__pypackages__/
.env
.env.*
!.env.example

